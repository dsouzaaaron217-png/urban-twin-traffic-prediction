# ==============================================================================
# TrafficWatch Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder with your actual API key:
#   copy .env.example .env
#
# DO NOT commit .env or paste your real API key into this template file.
# ==============================================================================

# TomTom Developer API Key
# Required for live traffic flow queries, geocoding search, and routing calculations.
# Obtain a free API key at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# Phase 1 scheduled collection controls
# Scheduler remains disabled unless explicitly enabled.
ENABLE_TOMTOM_SCHEDULER=false
TOMTOM_DAILY_REQUEST_BUDGET=500

# Google Routes spot checks stay disabled until terms are confirmed.
# Stored Google route results stay disabled until the storage policy is confirmed.
GOOGLE_ROUTES_API_KEY=
ENABLE_GOOGLE_ROUTES_SPOT_CHECKS=false
GOOGLE_ROUTES_DAILY_REQUEST_BUDGET=50

# Phase 2 scheduled retraining is opt-in and performs no live API calls.
ENABLE_MODEL_RETRAINING=false
MODEL_RETRAIN_INTERVAL_HOURS=24

# Phase 3 backend settings
# Admin writes/retraining are disabled until a non-empty local secret is configured.
API_KEY=
RATE_LIMIT_PER_MINUTE=600
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# SQLite development default. For PostgreSQL, use postgresql+psycopg://user:password@host:5432/dbname.
DATABASE_URL=sqlite:///./data/phase1_ingestion.sqlite3
